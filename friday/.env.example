# =============================================================================
# Friday AI Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# cp .env.example .env

# --- LiveKit (required for voice) ---
# Get these from https://cloud.livekit.io or your self-hosted server
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Google Gemini (required) ---
# Get your API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Speech-to-Text Backend ---
# Options: deepgram (recommended), google
# Deepgram: https://console.deepgram.com/signup
STT_BACKEND=deepgram
DEEPGRAM_API_KEY=

# --- Text-to-Speech Backend ---
# Options: cartesia (recommended), elevenlabs, google
# Cartesia: https://play.cartesia.ai/
TTS_BACKEND=cartesia
CARTESIA_API_KEY=
# ElevenLabs: https://elevenlabs.io/
# ELEVENLABS_API_KEY=
# OpenAI TTS: https://platform.openai.com/
# OPENAI_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
